write a cpp program to sort data items in ascending order using function templates



#include<iostream>
using namespace std;

template<class T>
void my_sort(T a[],int n)
{
        for(int i=0;i<n-1;i++)
        {
                for(int j=i+1;j<n;j++)
                {
                        if(a[i]>a[j])
                        {
                                T temp=a[i];
                                a[i]=a[j];
                                a[j]=temp;
                        }
                }
        }
}


int main()
{
        int n;
        cout<<"enter the number of elements:"<<endl;
        cin>>n;


        int a[100];
        cout<<"enter the elements"<<endl;
        for(int i=0;i<n;i++)
        {
                cin>>a[i];
        }

        my_sort(a,n);


        cout<<"sorted elements:"<<endl;
        for(int i=0;i<n;i++)
        {
                cout<<a[i]<<" ";
        }
        cout<<endl;
}
